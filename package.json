	"version": "0.1.101",
	"type": "module",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:tokens": "node scripts/check-tokens.mjs",
		"test": "node --experimental-vm-modules --test scripts/*.test.mjs",
		"test:smoke": "playwright test",
		"test:coverage": "node --experimental-vm-modules --test scripts/next-month-coverage.test.mjs",
		"test:lifecycle": "node --experimental-vm-modules --test scripts/template-plan-lifecycle.test.mjs",
		"lint": "eslint .",
		"format": "eslint --fix . && prettier --write .",
		"format:check": "prettier --check .",
		"generate:features-manifest": "node scripts/generate-features-manifest.mjs",
		"generate:large-budget": "node scripts/generate-large-budget.mjs",
		"new-feature": "node scripts/new-feature.mjs",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/d3": "^7.4.3",
		"@wxt-dev/module-svelte": "^2.0.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.71.1",
		"wxt": "^0.20.6"
	},
	"packageManager": "pnpm@10.19.0",
	"dependencies": {
		"@lucide/svelte": "^1.55.0",
		"d3": "^7.9.0",
		"d3-sankey": "^0.12.3",
		"unicode-emoji-json": "^0.9.0"
	}
}
