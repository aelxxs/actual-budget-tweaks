---
const faqs = [
	{
		q: "Does this access my financial data?",
		a: "ABT reads your budget through Actual itself, in your browser, for features like the Inspector and Sync recap. It only changes your budget when you click to, and your budget data is not sent anywhere else. Its own settings are saved in your budget's synced preferences, so they follow you to every device.",
	},
	{
		q: "Will it break when Actual Budget updates?",
		a: "Some features might, until ABT is updated. Your budget data is not affected, and you can turn off any setting that misbehaves.",
	},
	{
		q: "Does this work with any Actual Budget instance?",
		a: "Yes, it works with any self-hosted instance. Enter your Actual URL in the extension's popup, or run the sidecar in front of your server.",
	},
	{
		q: "Can I use only some features?",
		a: "Yes. Each feature has its own switch, and a few need another setting turned on first. Category filter, for example, needs Page headers.",
	},
	{
		q: "Does this work on mobile?",
		a: "Yes, through the sidecar: it adds ABT to any browser that opens your Actual address, phones included. The extension itself runs on desktop Chrome and Firefox. On a phone, a Mobile section of tweaks restyles Actual's mobile app: a tab bar, sheets for its pop-ups, cards, an accounts list with your groups and icons, and more.",
	},
];
---

<section class="trust" data-reveal>
	<div class="center">
		<!-- Row 1: trust text + settings demo (original layout) -->
		<div class="trust__top">
			<div class="stack stack--md">
				<h2 class="trust__heading">Runs on top of Actual</h2>
				<p class="trust__body">
					ABT is a browser extension or self-hosted sidecar for the Actual server you
					already run. It changes the interface in your browser, and your budget
					only changes when you ask it to. Turn a setting off and Actual's original
					interface comes back.
				</p>
				<ul class="trust__checks stack stack--xs">
					<li>Uses Actual's theme colors, so it matches any theme</li>
					<li>Works with any self-hosted Actual instance</li>
					<li>Settings sync with your budget across devices</li>
					<li>Open source</li>
				</ul>
			</div>

			<div class="trust__visual">
				<img
					class="trust__shot"
					src={`${import.meta.env.BASE_URL}images/features/tweaks.png`}
					width="640"
					height="560"
					alt="ABT's settings in Actual: the theme card, then each feature with a one-line description and its own switch"
					loading="lazy"
				/>
			</div>
		</div>

		<!-- Row 2: FAQ -->
		<div class="trust__faq" data-reveal>
			<h3 class="faq__heading">Common questions</h3>
			<div class="faq__list">
				{faqs.map(f => (
					<details class="faq__item">
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.trust {
		padding-block: 6rem;
	}

	/* Row 1: two-column trust + settings */
	.trust__top {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.trust__heading {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.trust__body {
		color: var(--text-secondary);
		font-size: 1rem;
		line-height: 1.65;
	}

	.trust__checks { list-style: none; }

	.trust__checks li {
		font-size: 0.92rem;
		color: var(--text-secondary);
		padding-inline-start: 1.4rem;
		position: relative;
	}

	.trust__checks li::before {
		content: "✓";
		position: absolute;
		inset-inline-start: 0;
		color: var(--accent);
		font-weight: 700;
	}

	/* Row 2: FAQ centered below */
	.trust__faq {
		margin-block-start: 4rem;
		padding-block-start: 3rem;
		border-block-start: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.faq__heading {
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-block-end: 1rem;
	}

	.faq__list {
		max-inline-size: 640px;
		inline-size: 100%;
	}

	.faq__item {
		border-block-end: 1px solid var(--border);
	}

	.faq__item summary {
		padding: 0.85rem 0;
		font-size: 0.95rem;
		font-weight: 500;
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}

	.faq__item summary::after {
		content: "+";
		font-size: 1.1rem;
		color: var(--text-tertiary);
		flex-shrink: 0;
	}

	.faq__item[open] summary::after { content: "−"; }

	.faq__item p {
		padding: 0 0 0.85rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	/* ABT's own settings page, faded out at the bottom where the crop ends. */
	.trust__shot {
		display: block;
		inline-size: 100%;
		block-size: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-lg);
		mask-image: linear-gradient(to bottom, black 80%, transparent);
	}

	@media (max-width: 768px) {
		.trust__top { grid-template-columns: 1fr; gap: 2.5rem; }
		.trust__visual { order: 2; }
	}
</style>

