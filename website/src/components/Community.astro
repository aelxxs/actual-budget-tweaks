---
import fs from "node:fs";
import path from "node:path";

const res = await fetch("https://api.github.com/repos/aelxxs/actual-budget-tweaks/contributors");
// The release workflow commits as github-actions[bot], which isn't anyone to credit.
const contributors: { login: string; avatar_url: string; html_url: string; type: string }[] = (
	res.ok ? await res.json() : []
).filter((c: { type: string }) => c.type !== "Bot");

const raw = fs.readFileSync(path.resolve("../CHANGELOG.md"), "utf-8");

interface Change {
	text: string;
	type: "enhancement" | "fix";
}

interface Release {
	version: string;
	compareUrl: string;
	changes: Change[];
	/** The rest of the release's features and fixes, past the ones shown. */
	more: number;
}

// A few lines per release keep the column level with the contributors beside it.
const SHOWN = 4;

function parseChangelog(md: string, count: number): Release[] {
	const releases: Release[] = [];
	const blocks = md.split(/^## /m).slice(1);

	for (const block of blocks) {
		if (releases.length >= count) break;

		const lines = block.trim().split("\n");
		const version = lines[0].trim();
		const compareMatch = block.match(/\[compare changes\]\((.*?)\)/);
		const compareUrl = compareMatch?.[1] ?? "";

		const changes: Change[] = [];
		let currentType: string | null = null;

		for (const line of lines) {
			if (line.includes("🚀 Enhancements")) currentType = "enhancement";
			else if (line.includes("🩹 Fixes")) currentType = "fix";
			else if (line.includes("💅 Refactors") || line.includes("🏡 Chore") || line.includes("❤️ Contributors")) currentType = null;
			else if (line.startsWith("- ") && currentType) {
				const text = line
					.replace(/^- /, "")
					.replace(/\s*\(\[[\da-f]+\]\(.*?\)\)/, "")
					.replace(/\*\*(.*?):\*\*\s*/, "")
					.trim();
				if (text) changes.push({ text, type: currentType as Change["type"] });
			}
		}

		if (changes.length > 0) {
			const features = changes.filter((c) => c.type === "enhancement");
			const lead = (features.length ? features : changes).slice(0, SHOWN);
			releases.push({ version, compareUrl, changes: lead, more: changes.length - lead.length });
		}
	}

	return releases;
}

const releases = parseChangelog(raw, 3);

// The first few by name, the rest as a count, so the line stays one sentence.
const credit = contributors.slice(0, 3);
const others = contributors.length - credit.length;
const base = import.meta.env.BASE_URL;
---

<section class="community" data-reveal>
	<div class="center">
		<!-- Open source heading -->
		<div class="oss" data-reveal>
			<div class="oss__icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
			</div>
			<h2 class="oss__heading">Open source</h2>
			<p class="oss__body">
				ABT is free and has no telemetry. You can read the code, fork it or contribute a tweak.
			</p>
			<div class="oss__actions cluster" style="--cluster-gap:0.75rem; justify-content:center">
				<a href="https://github.com/aelxxs/actual-budget-tweaks" target="_blank" rel="noopener" class="btn btn--secondary">
					View on GitHub
				</a>
				<a href="https://github.com/aelxxs/actual-budget-tweaks/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="btn btn--primary">
					Contribute a tweak
				</a>
			</div>
			<p class="oss__support">
				Like ABT?
				<a href="https://github.com/sponsors/aelxxs" target="_blank" rel="noopener">Sponsor it on GitHub</a>
				or <a href="https://ko-fi.com/aelxxs" target="_blank" rel="noopener">leave a tip on Ko-fi</a>.
			</p>
		</div>

		<!-- Two-column: contributors + what's new -->
		<div class="community__grid" data-reveal>
			<div class="community__col">
				<span class="tag">Contributors</span>
				<div class="pile">
					{contributors.map((c) => (
						<a href={c.html_url} target="_blank" rel="noopener" class="pile__face" data-name={c.login} aria-label={c.login}>
							<img src={c.avatar_url} alt="" width="56" height="56" loading="lazy" />
						</a>
					))}
					<a href="https://github.com/aelxxs/actual-budget-tweaks/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="pile__face pile__you" data-name="You?" aria-label="Contribute a tweak">+</a>
				</div>
				{credit.length > 0 && (
					<p class="pile__credit">
						{credit.map((c, i) => [i === 0 ? "" : i === credit.length - 1 && others === 0 ? " and " : ", ", <a href={c.html_url} target="_blank" rel="noopener">{c.login}</a>])}{others > 0 ? ` and ${others} ${others === 1 ? "other" : "others"}` : ""} helped build ABT.
					</p>
				)}
			</div>

			<div class="community__col">
				<span class="tag">Latest releases</span>
				<div class="wn__timeline">
					{releases.map((r, i) => (
						<div class="wn-release">
							<div class="wn-release__marker"></div>
							<div class="wn-release__content">
								<a href={r.compareUrl} target="_blank" rel="noopener" class="wn-release__version">{r.version}</a>
								<ul class="wn-release__list">
									{r.changes.map(c => (
										<li>
											<span class={`wn-dot wn-dot--${c.type}`}></span>
											{c.text}
										</li>
									))}
								</ul>
								{r.more > 0 && (
									<a
										href={i === 0 ? `${base}latest` : `https://github.com/aelxxs/actual-budget-tweaks/releases/tag/${r.version}`}
										target={i === 0 ? undefined : "_blank"}
										rel={i === 0 ? undefined : "noopener"}
										class="wn-release__more"
									>
										and {r.more} more {r.more === 1 ? "change" : "changes"}
									</a>
								)}
							</div>
						</div>
					))}
				</div>
				<div class="cluster wn__links" style="--cluster-gap:1.25rem">
					<a href={`${base}latest`} class="wn__all">What's new</a>
					<a href="https://github.com/aelxxs/actual-budget-tweaks/releases" target="_blank" rel="noopener" class="wn__all">
						All releases
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.community {
		padding-block: 4rem 5rem;
		border-block-start: 1px solid var(--border);
	}

	/* ── Open Source ── */
	.oss__support {
		margin-block-start: 1.25rem;
		font-size: 0.85rem;
		color: var(--text-tertiary);
	}

	.oss {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-block-end: 3.5rem;
	}

	.oss__icon {
		color: var(--accent);
		margin-block-end: 0.75rem;
	}

	.oss__heading {
		font-size: clamp(1.4rem, 3vw, 1.8rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-block-end: 0.5rem;
	}

	.oss__body {
		color: var(--text-secondary);
		font-size: 1rem;
		line-height: 1.6;
		max-inline-size: 460px;
		margin-block-end: 1.25rem;
	}

	/* ── Two-column grid ── */
	.community__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		border-block-start: 1px solid var(--border);
		padding-block-start: 2.5rem;
	}

	.community__col .tag {
		margin-block-end: 1rem;
	}

	/* ── Contributors ── */
	/* Overlapping avatars, each cut out of the page with a ring, lifting on hover with its name. */
	.pile {
		display: flex;
		padding-block: 1.75rem 0.25rem;
		padding-inline-start: 14px;
	}

	.pile__face {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		inline-size: 56px;
		block-size: 56px;
		margin-inline-start: -14px;
		border-radius: 50%;
		border: 3px solid var(--bg);
		background: var(--bg-alt);
		text-decoration: none;
		transition: translate 0.2s;
	}

	.pile__face img {
		inline-size: 100%;
		block-size: 100%;
		border-radius: 50%;
	}

	.pile__face:hover,
	.pile__face:focus-visible {
		z-index: 1;
		translate: 0 -4px;
	}

	.pile__face::after {
		content: attr(data-name);
		position: absolute;
		inset-block-end: calc(100% + 8px);
		inset-inline-start: 50%;
		translate: -50% 4px;
		padding: 0.2rem 0.5rem;
		border-radius: var(--radius-sm);
		background: var(--text);
		color: var(--bg);
		font-family: var(--mono);
		font-size: 0.75rem;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s, translate 0.15s;
	}

	.pile__face:hover::after,
	.pile__face:focus-visible::after {
		opacity: 1;
		translate: -50% 0;
	}

	/* Overlaps and rings like the avatars, with the dashed outline drawn inside the ring. */
	.pile__you {
		background: var(--bg);
		color: var(--text-tertiary);
		font-size: 1.3rem;
	}

	.pile__you::before {
		content: "";
		position: absolute;
		inset: 0;
		border: 2px dashed var(--border-strong);
		border-radius: 50%;
		transition: border-color 0.2s;
	}

	.pile__you:hover {
		color: var(--accent);
	}

	.pile__you:hover::before {
		border-color: var(--accent);
	}

	.pile__credit {
		margin-block-start: 1rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.pile__credit a {
		color: var(--text);
		font-weight: 500;
	}

	.pile__credit a:hover {
		color: var(--accent);
	}

	/* ── What's new timeline ── */
	.wn__timeline {
		position: relative;
		padding-inline-start: 20px;
	}

	.wn__timeline::before {
		content: "";
		position: absolute;
		inset-inline-start: 5px;
		inset-block: 0;
		inline-size: 1px;
		background: var(--border);
	}

	.wn-release {
		position: relative;
		padding-block-end: 1.25rem;
	}

	.wn-release:last-child {
		padding-block-end: 0;
	}

	.wn-release__marker {
		position: absolute;
		inset-inline-start: -20px;
		inset-block-start: 2px;
		inline-size: 11px;
		block-size: 11px;
		border-radius: 50%;
		background: var(--surface);
		border: 2px solid var(--accent);
	}

	.wn-release__version {
		font-family: var(--mono);
		font-size: 0.85rem;
		font-weight: 600;
		margin-block-end: 0.3rem;
		display: inline-block;
	}

	.wn-release__list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.wn-release__list li {
		font-size: 0.82rem;
		color: var(--text-secondary);
		line-height: 1.45;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.wn-dot {
		inline-size: 6px;
		block-size: 6px;
		border-radius: 50%;
		flex-shrink: 0;
		translate: 0 1px;
	}

	.wn-dot--enhancement { background: var(--color-pos); }
	.wn-dot--fix { background: var(--accent); }

	.wn__links {
		margin-block-start: 1rem;
		padding-inline-start: 20px;
	}

	.wn__all {
		font-size: 0.82rem;
		font-weight: 500;
	}

	.wn-release__more {
		display: inline-block;
		margin-block-start: 0.35rem;
		font-size: 0.82rem;
		color: var(--text-tertiary);
	}

	.wn-release__more:hover {
		color: var(--accent);
	}

	@media (max-width: 768px) {
		.community__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
